# Brain API Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# HuggingFace Hub
# =============================================================================
# API token for HuggingFace Hub (required for HF storage backend)
HF_TOKEN=

# HuggingFace model repository (e.g., "username/learnfinance-models")
HF_MODEL_REPO=

# HuggingFace news sentiment dataset repository
HF_NEWS_SENTIMENT_REPO=

# HuggingFace twitter sentiment dataset repository
HF_TWITTER_SENTIMENT_REPO=

HF_LSTM_MODEL_REPO="username/learnfinance-lstm"
HF_PATCHTST_MODEL_REPO="username/learnfinance-patchtst"

# Per-bucket SAC HF repos. Two SAC buckets train in parallel (A/B
# comparison): ``halal_filtered`` (sticky-15 from PatchTST) and
# ``halal`` (legacy yfinance ETF top-holdings, variable size). Each
# bucket has an independent ``current`` pointer; promoting one MUST
# NOT touch the other.
HF_SAC_HALAL_FILTERED_MODEL_REPO="username/learnfinance-models-sac-halal-filtered"
HF_SAC_HALAL_MODEL_REPO="username/learnfinance-models-sac-halal"

# =============================================================================
# Storage Backend
# =============================================================================
# Storage *read* policy. Writes always go to local AND HuggingFace
# whenever the bucket has an HF repo configured (uploads are no longer
# gated by this var).
#
# Valid values (anything else fails the API at startup):
#   local_first  Read local first; on miss, download from HF, persist
#                locally + atomic-promote, then return. Default when
#                this var is unset or empty.
#   hf_first     Cheap metadata.json fetch from HF main; if local
#                version matches, short-circuit to local; otherwise
#                download from HF, persist + promote, then return.
#
# Cold-start (HF main missing):
#   - Inference -> 503 with an actionable error message.
#   - Training prior-version -> None (treat new run as inaugural
#     promotion). Snapshot ensure under hf_first without an HF repo
#     configured -> StoragePolicyError.
#
# Legacy values 'local' and 'hf' are no longer accepted -- the
# operator must migrate before boot succeeds.
STORAGE_BACKEND=local_first

# =============================================================================
# Alpaca News API
# =============================================================================
# Required for news sentiment backfill via Alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=

# =============================================================================
# Alpaca Trading (paper by default, live via URL override)
# =============================================================================
# SAC algorithm account
ALPACA_SAC_KEY=
ALPACA_SAC_SECRET=
# HRP algorithm account
ALPACA_HRP_KEY=
ALPACA_HRP_SECRET=
# Double HRP algorithm account (halal_new universe, sticky-selected)
ALPACA_DHRP_KEY=
ALPACA_DHRP_SECRET=

# Per-account Alpaca host. Empty = paper (https://paper-api.alpaca.markets).
# Set to https://api.alpaca.markets to flip an account to live.
# Live URL requires LIVE API key+secret for that account (paper keys will 403).
ALPACA_SAC_URL=
ALPACA_HRP_URL=
ALPACA_DHRP_URL=

# =============================================================================
# Alpha Vantage API
# =============================================================================
# Required for /signals/fundamentals/historical endpoint
ALPHA_VANTAGE_API_KEY=

# =============================================================================
# Training Configuration (Optional)
# =============================================================================
# Number of years of historical data for training (default: 15)
# LSTM_TRAIN_LOOKBACK_YEARS=15

# Override end date for training window (default: today)
# LSTM_TRAIN_WINDOW_END_DATE=2025-01-01

# =============================================================================
# LLM Configuration
# =============================================================================
# LLM provider: "openai" (default) or "ollama"
LLM_PROVIDER=openai

# OpenAI configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OLLAMA configuration (required if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# =============================================================================
# Email Configuration (Gmail)
# =============================================================================
# Gmail account for sending emails
GMAIL_USER=
# Gmail app password (not regular password - create at https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=
# Training summary email recipient
TRAINING_EMAIL_TO=
# CC recipients (optional, comma-separated)
# TRAINING_EMAIL_CC=

{# US Double HRP weekly email.

Inherits the math-aware Stage 1 + Sticky + Stage 2 sections from
``double_hrp_email_base.html.j2`` so US and India read identically.
Only US-specific copy + the Alpaca-paper order-execution / skipped
notice blocks are overridden here. #}
{% extends "double_hrp_email_base.html.j2" %}

{% block document_title %}US Double HRP Portfolio Analysis{% endblock %}

{% block header %}
  <h1 style="color: #1f2937; margin-bottom: 8px;">US Double HRP Portfolio Analysis (Alpaca Paper)</h1>
  <div style="background-color: {{ self.strategy_header_bg() }}; padding: 16px; border-radius: 8px; margin-bottom: 24px; border-left: 4px solid {{ self.strategy_primary() }};">
    <strong>Target Week:</strong> {{ target_week_start }} &rarr; {{ target_week_end }} &nbsp;|&nbsp;
    <strong>As-of Date:</strong> {{ as_of_date }} &nbsp;|&nbsp;
    <strong>Universe:</strong> {{ universe }} &nbsp;|&nbsp;
    <strong>Strategy:</strong> Two-stage HRP + weight-band sticky (screen {{ stage1.symbols_used }} &rarr; top {{ top_n }})
  </div>
{% endblock %}

{% block skipped_notice %}
  <div style="margin-bottom: 24px; padding: 20px; background-color: #fef3c7; border-radius: 12px; border-left: 4px solid #f59e0b;">
    <h2 style="margin-top: 0; margin-bottom: 12px; color: #92400e;">Run Skipped</h2>
    <p style="margin: 0; color: #78350f;">
      US Double HRP did not place new orders this week because the dhrp Alpaca account
      still has open orders from a previous run. Cancel them in the Alpaca dashboard
      and rerun to refresh allocations.
    </p>
  </div>
{% endblock %}

{% block order_execution_heading %}Alpaca Order Execution (dhrp account){% endblock %}
